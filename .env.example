# Backend Environment Variables
# Copy this file to .env and fill in the values

# ── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://127.0.0.1:5432/poker
DB_USERNAME=poker
DB_PASSWORD=your_secure_password_here

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── JWT Keys ────────────────────────────────────────────────────────────────
# Generate with:
#   mkdir -p secrets
#   openssl genrsa -out secrets/privateKey.pem 2048
#   openssl rsa -in secrets/privateKey.pem -pubout -out secrets/publicKey.pem
JWT_SIGN_KEY=secrets/privateKey.pem
JWT_VERIFY_KEY=secrets/publicKey.pem

# ── JWT Configuration ──────────────────────────────────────────────────────
JWT_ISSUER=https://manestack.dev
